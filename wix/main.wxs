<?xml version='1.0' encoding='utf-8'?>
<!--
  LocalAgent umbrella Windows installer (WiX v4 format).
  Bundles zeroclaw (local agent) and all MCP servers into a single MSI.

  Build: the release workflow calls `wix build` with the pre-built binaries.
-->
<Wix xmlns='http://wixtoolset.org/schemas/v4/wxs'
     xmlns:ui='http://wixtoolset.org/schemas/v4/wxs/ui'>

    <Package
        Name='LocalAgent'
        UpgradeCode='D7E1A2B3-4C5D-6E7F-8A9B-0C1D2E3F4A5B'
        Manufacturer='OpenClaw'
        Language='1033'
        Version='$(var.Version)'
        Scope='perMachine'>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.' />

        <MediaTemplate EmbedCab='yes' />

        <StandardDirectory Id='ProgramFiles64Folder'>
            <Directory Id='APPLICATIONFOLDER' Name='LocalAgent'>

                <!-- zeroclaw local agent -->
                <Component Id='ZeroclawBinary' Guid='*'>
                    <File
                        Id='zeroclaw_exe'
                        Name='zeroclaw.exe'
                        Source='$(var.BinDir)\zeroclaw.exe'
                        KeyPath='yes' />
                </Component>

                <!-- browser-server MCP server -->
                <Component Id='BrowserServerBinary' Guid='*'>
                    <File
                        Id='browser_server_exe'
                        Name='browser-server.exe'
                        Source='$(var.BinDir)\browser-server.exe'
                        KeyPath='yes' />
                </Component>

                <!-- config-server MCP server -->
                <Component Id='ConfigServerBinary' Guid='*'>
                    <File
                        Id='config_server_exe'
                        Name='config-server.exe'
                        Source='$(var.BinDir)\config-server.exe'
                        KeyPath='yes' />
                </Component>

            </Directory>
        </StandardDirectory>

        <!-- Add install directory to system PATH -->
        <Component Id='PathEntry' Guid='C1D2E3F4-A5B6-7C8D-9E0F-A1B2C3D4E5F6' Directory='APPLICATIONFOLDER'>
            <Environment
                Id='PATH'
                Name='PATH'
                Value='[APPLICATIONFOLDER]'
                Permanent='no'
                Part='last'
                Action='set'
                System='yes' />
        </Component>

        <!-- Feature tree shown in the installer UI -->
        <Feature
            Id='Complete'
            Title='LocalAgent'
            Description='LocalAgent - local-cloud agent system with zeroclaw and MCP servers.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            AllowAbsent='no'>

            <!-- zeroclaw is always installed -->
            <Feature
                Id='LocalAgent'
                Title='zeroclaw (Local Agent)'
                Description='The zeroclaw local agent for enterprise task automation.'
                Level='1'
                AllowAbsent='no'>
                <ComponentRef Id='ZeroclawBinary' />
            </Feature>

            <!-- MCP servers are optional features -->
            <Feature
                Id='McpServers'
                Title='MCP Servers'
                Description='MCP servers providing automation primitives.'
                Level='1'
                Display='expand'
                AllowAbsent='yes'>

                <Feature
                    Id='BrowserMcp'
                    Title='Browser MCP Server'
                    Description='Headless browser automation via Chrome DevTools Protocol.'
                    Level='1'
                    AllowAbsent='yes'>
                    <ComponentRef Id='BrowserServerBinary' />
                </Feature>

                <Feature
                    Id='ConfigMcp'
                    Title='Config MCP Server'
                    Description='Manage zeroclaw configuration through MCP tools.'
                    Level='1'
                    AllowAbsent='yes'>
                    <ComponentRef Id='ConfigServerBinary' />
                </Feature>

            </Feature>

            <Feature
                Id='PathEnvironment'
                Title='PATH Environment Variable'
                Description='Add LocalAgent to the system PATH so all tools can be run from any command prompt.'
                Level='1'
                AllowAbsent='yes'>
                <ComponentRef Id='PathEntry' />
            </Feature>
        </Feature>

        <Property Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' />

        <ui:WixUI Id='WixUI_FeatureTree' />

    </Package>

</Wix>
