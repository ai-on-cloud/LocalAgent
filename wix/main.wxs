<?xml version='1.0' encoding='utf-8'?>
<!--
  LocalAgent umbrella Windows installer (WiX v4 format).
  Bundles zeroclaw (local agent) and all MCP servers into a single MSI.

  Build: the release workflow calls `wix build` with the pre-built binaries.
-->
<Wix xmlns='http://wixtoolset.org/schemas/v4/wxs'
     xmlns:ui='http://wixtoolset.org/schemas/v4/wxs/ui'>

    <Package
        Name='LocalAgent'
        UpgradeCode='D7E1A2B3-4C5D-6E7F-8A9B-0C1D2E3F4A5B'
        Manufacturer='OpenClaw'
        Language='1033'
        Version='$(var.Version)'
        Scope='perMachine'>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.' />

        <MediaTemplate EmbedCab='yes' />

        <!-- Installer properties for API config dialog -->
        <Property Id='API_KEY' Value='' Secure='yes' />
        <Property Id='PROVIDER' Value='openrouter' />
        <Property Id='ACTIVITY_ARN' Value='' />

        <StandardDirectory Id='ProgramFiles64Folder'>
            <Directory Id='APPLICATIONFOLDER' Name='LocalAgent'>

                <!-- zeroclaw local agent -->
                <Component Id='ZeroclawBinary' Guid='*'>
                    <File
                        Id='zeroclaw_exe'
                        Name='zeroclaw.exe'
                        Source='$(var.BinDir)\zeroclaw.exe'
                        KeyPath='yes' />
                </Component>

                <!-- browser-server MCP server -->
                <Component Id='BrowserServerBinary' Guid='*'>
                    <File
                        Id='browser_server_exe'
                        Name='browser-server.exe'
                        Source='$(var.BinDir)\browser-server.exe'
                        KeyPath='yes' />
                </Component>

                <!-- config-server MCP server -->
                <Component Id='ConfigServerBinary' Guid='*'>
                    <File
                        Id='config_server_exe'
                        Name='config-server.exe'
                        Source='$(var.BinDir)\config-server.exe'
                        KeyPath='yes' />
                </Component>

                <!-- Launcher batch file -->
                <Component Id='LauncherScript' Guid='*'>
                    <File
                        Id='start_localagent_bat'
                        Name='start-localagent.bat'
                        Source='$(var.BinDir)\start-localagent.bat'
                        KeyPath='yes' />
                </Component>

                <!-- Config writer PowerShell script -->
                <Component Id='WriteConfigScript' Guid='*'>
                    <File
                        Id='write_config_ps1'
                        Name='write-config.ps1'
                        Source='$(var.BinDir)\write-config.ps1'
                        KeyPath='yes' />
                </Component>

            </Directory>
        </StandardDirectory>

        <!-- Add install directory to system PATH -->
        <Component Id='PathEntry' Guid='C1D2E3F4-A5B6-7C8D-9E0F-A1B2C3D4E5F6' Directory='APPLICATIONFOLDER'>
            <Environment
                Id='PATH'
                Name='PATH'
                Value='[APPLICATIONFOLDER]'
                Permanent='no'
                Part='last'
                Action='set'
                System='yes' />
        </Component>

        <!-- Custom action: write config.toml on fresh install -->
        <CustomAction
            Id='WriteConfig'
            Directory='APPLICATIONFOLDER'
            ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "[APPLICATIONFOLDER]write-config.ps1" -ApiKey "[API_KEY]" -Provider "[PROVIDER]" -ActivityArn "[ACTIVITY_ARN]"'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore' />

        <InstallExecuteSequence>
            <Custom Action='WriteConfig' After='InstallFiles'>
                <![CDATA[NOT Installed]]>
            </Custom>
        </InstallExecuteSequence>

        <!-- Feature tree shown in the installer UI -->
        <Feature
            Id='Complete'
            Title='LocalAgent'
            Description='LocalAgent - local-cloud agent system with zeroclaw and MCP servers.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            AllowAbsent='no'>

            <!-- zeroclaw is always installed -->
            <Feature
                Id='LocalAgent'
                Title='zeroclaw (Local Agent)'
                Description='The zeroclaw local agent for enterprise task automation.'
                Level='1'
                AllowAbsent='no'>
                <ComponentRef Id='ZeroclawBinary' />
            </Feature>

            <!-- MCP servers are optional features -->
            <Feature
                Id='McpServers'
                Title='MCP Servers'
                Description='MCP servers providing automation primitives.'
                Level='1'
                Display='expand'
                AllowAbsent='yes'>

                <Feature
                    Id='BrowserMcp'
                    Title='Browser MCP Server'
                    Description='Headless browser automation via Chrome DevTools Protocol.'
                    Level='1'
                    AllowAbsent='yes'>
                    <ComponentRef Id='BrowserServerBinary' />
                </Feature>

                <Feature
                    Id='ConfigMcp'
                    Title='Config MCP Server'
                    Description='Manage zeroclaw configuration through MCP tools.'
                    Level='1'
                    AllowAbsent='yes'>
                    <ComponentRef Id='ConfigServerBinary' />
                </Feature>

            </Feature>

            <!-- Launcher and scripts -->
            <Feature
                Id='LauncherFeature'
                Title='Launcher &amp; Scripts'
                Description='Batch launcher and configuration scripts for easy startup.'
                Level='1'
                AllowAbsent='yes'>
                <ComponentRef Id='LauncherScript' />
                <ComponentRef Id='WriteConfigScript' />
            </Feature>

            <Feature
                Id='PathEnvironment'
                Title='PATH Environment Variable'
                Description='Add LocalAgent to the system PATH so all tools can be run from any command prompt.'
                Level='1'
                AllowAbsent='yes'>
                <ComponentRef Id='PathEntry' />
            </Feature>
        </Feature>

        <Property Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' />

        <!-- Custom dialog for API configuration -->
        <ui:WixUI Id='WixUI_FeatureTree' />

        <UI>
            <!-- API Config dialog -->
            <Dialog Id='ApiConfigDlg' Width='370' Height='270' Title='[ProductName] Setup'>
                <Control Id='Title' Type='Text' X='15' Y='6' Width='200' Height='15' Transparent='yes' NoPrefix='yes' Text='{\WixUI_Font_Title}API Configuration' />
                <Control Id='Description' Type='Text' X='25' Y='23' Width='280' Height='15' Transparent='yes' NoPrefix='yes' Text='Configure your AI provider and optional Activity channel.' />
                <Control Id='BannerLine' Type='Line' X='0' Y='44' Width='370' Height='0' />

                <Control Id='ApiKeyLabel' Type='Text' X='20' Y='60' Width='100' Height='13' NoPrefix='yes' Text='API Key:' />
                <Control Id='ApiKeyEdit' Type='Edit' X='20' Y='75' Width='330' Height='18' Property='API_KEY' />

                <Control Id='ProviderLabel' Type='Text' X='20' Y='105' Width='100' Height='13' NoPrefix='yes' Text='Provider (default: openrouter):' />
                <Control Id='ProviderEdit' Type='Edit' X='20' Y='120' Width='330' Height='18' Property='PROVIDER' />

                <Control Id='ActivityArnLabel' Type='Text' X='20' Y='150' Width='280' Height='13' NoPrefix='yes' Text='Activity ARN (optional, for AWS Step Functions):' />
                <Control Id='ActivityArnEdit' Type='Edit' X='20' Y='165' Width='330' Height='18' Property='ACTIVITY_ARN' />

                <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0' />
                <Control Id='Back' Type='PushButton' X='180' Y='243' Width='56' Height='17' Text='&amp;Back'>
                    <Publish Event='NewDialog' Value='WelcomeDlg'>1</Publish>
                </Control>
                <Control Id='Next' Type='PushButton' X='236' Y='243' Width='56' Height='17' Default='yes' Text='&amp;Next'>
                    <Publish Event='NewDialog' Value='CustomizeDlg'>1</Publish>
                </Control>
                <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17' Cancel='yes' Text='Cancel'>
                    <Publish Event='SpawnDialog' Value='CancelDlg'>1</Publish>
                </Control>
            </Dialog>

            <!-- Wire ApiConfigDlg into WixUI_FeatureTree navigation -->
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='ApiConfigDlg' Order='2'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='ApiConfigDlg' Order='2'>1</Publish>
        </UI>

    </Package>

</Wix>
